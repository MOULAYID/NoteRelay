{
  "name": "noterelay",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Local-first lecture recording, reusable transcripts, and source-linked study notes.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "package": "npm run build && python3 scripts/package.py",
    "benchmark": "python3 benchmarks/evaluate.py",
    "format": "prettier --write src tests scripts *.json *.ts *.js docs *.md .github",
    "format:check": "prettier --check src tests scripts *.json *.ts *.js docs *.md .github"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MOULAYID/NoteRelay.git"
  },
  "dependencies": {
    "dexie": "4.4.7",
    "marked": "15.0.12",
    "pdfmake": "0.2.23",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.7",
    "@types/node": "^26.6.6",
    "@types/pdfmake": "0.2.11",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "fake-indexeddb": "6.2.7",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
